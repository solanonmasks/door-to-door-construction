---
import Base from '../layouts/Base.astro';
import { img } from '../data/images';
import { services } from '../data/services';
---
<Base
  title="Services | Door to Door Construction, Surrey"
  description="Kitchens, baths and basements; additions and new builds; exteriors, decks and roofs; and repairs that can’t wait. One Surrey contractor for every trade."
  ogImage="/images/Granite-Countertops.jpg"
>
  <section style="background:#7A35B0">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px)">
      <h1 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(64px,9vw,168px);line-height:0.84;text-transform:uppercase;margin:0">Services</h1>
      <p style="margin:20px 0 0;max-width:34em;font-size:20px;font-weight:500">Four kinds of work, one contractor. If your project crosses several, that’s exactly what we’re set up for.</p>
    </div>
  </section>
  {services.map((s) => (
    <article id={s.id} style={`background:${s.bg};color:${s.fg};scroll-margin-top:88px`}>
      <div style={`max-width:1440px;margin:0 auto;display:flex;flex-wrap:wrap;flex-direction:${s.dir}`}>
        <div style="flex:1.2 1 520px;min-width:0;position:relative;min-height:440px"><img src={img(s.image)} alt={s.title} loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></div>
        <div style="flex:1 1 400px;min-width:0;padding:clamp(40px,5vw,80px) clamp(20px,4vw,64px);display:flex;flex-direction:column;gap:18px;justify-content:center">
          <h2 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(44px,4.6vw,76px);line-height:0.88;text-transform:uppercase;margin:0">{s.title}</h2>
          <p style="margin:0">{s.long}</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:6px 24px;font-weight:700">
            {s.items.map((it) => <span style={`padding:8px 0;border-bottom:2px solid ${s.rule}`}>{it}</span>)}
          </div>
          <a href="/contact" class={s.btnHover} style={`align-self:flex-start;margin-top:8px;background:${s.btnBg};color:${s.btnFg};font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:18px;text-transform:uppercase;padding:17px 26px;text-decoration:none`}>Estimate for {s.short}</a>
        </div>
      </div>
    </article>
  ))}
</Base>
