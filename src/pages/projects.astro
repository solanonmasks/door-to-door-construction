---
import Base from '../layouts/Base.astro';
import { img, type ImageKey } from '../data/images';

// Project photos and their captions, in order.
const work: { image: ImageKey; title: string }[] = [
  { image: 'kitchen8', title: 'Kitchen renovation' },
  { image: 'countertops', title: 'Countertops' },
  { image: 'remodel1', title: 'Remodel' },
  { image: 'project10', title: 'Finishing' },
  { image: 'framing', title: 'Framing' },
  { image: 'siding', title: 'Siding' },
  { image: 'project11', title: 'Construction' },
  { image: 'residential', title: 'New build' },
  { image: 'doors', title: 'Doors' },
  { image: 'renovation9', title: 'Renovation' },
  { image: 'remodel4', title: 'Remodel' },
  { image: 'finishing6', title: 'Finishing' },
];
---
<Base
  title="Projects | Door to Door Construction, Surrey"
  description="Renovation, construction and repair work from Door to Door Construction around Surrey and the Lower Mainland."
>
  <section style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) 0">
    <h1 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(64px,9vw,168px);line-height:0.84;text-transform:uppercase;margin:0">Projects</h1>
    <p style="margin:16px 0 0;max-width:34em;font-size:20px;color:#DCD7E0">Renovation, construction and repair work from around Surrey and the Lower Mainland.</p>
  </section>
  <section style="max-width:1440px;margin:0 auto;padding:40px clamp(20px,4vw,56px) clamp(64px,8vw,112px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:10px">
      {work.map((p, i) => (
        <figure style="position:relative;margin:0;aspect-ratio:4/3;overflow:hidden;background:#2E2A33"><img src={img(p.image)} alt={p.title} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" style="width:100%;height:100%;object-fit:cover"><figcaption style="position:absolute;left:0;bottom:0;background:#7A35B0;padding:8px 14px;font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:15px;text-transform:uppercase">{p.title}</figcaption></figure>
      ))}
    </div>
  </section>
</Base>
