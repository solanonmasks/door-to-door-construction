---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { img } from '../data/images';
import { services } from '../data/services';
---
<Base
  title="Door to Door Construction | Renovations, builds and repairs in Surrey"
  description="Surrey general contractor with 30+ years in the trade. Kitchens, bathrooms, basements, additions, exteriors, roofing and urgent repairs under one contract. Book a free estimate."
>
  <section style="display:flex;flex-wrap:wrap;background:#7A35B0">
    <div style="padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) clamp(40px,5vw,72px) max(clamp(20px,4vw,56px),calc((100vw - 1440px)/2 + 56px));display:flex;flex-direction:column;justify-content:space-between;gap:40px;flex:1.15 1 560px;min-width:0;position:relative;z-index:1">
      <h1 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(52px,6.6vw,124px);line-height:0.86;letter-spacing:0;text-transform:uppercase;margin:0;overflow-wrap:break-word">From the foundation <span style="color:#211E25">to the roof.</span></h1>
      <div style="display:flex;flex-direction:column;gap:26px">
        <p style="margin:0;font-size:clamp(18px,1.5vw,21px);max-width:30em;font-weight:500">Kitchens, bathrooms, basements, additions and the repairs that can’t wait. One Surrey general contractor, 30+ years in the trade, every trade under one contract.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a href="/contact" class="hover-invert" style="background:#FFFFFF;color:#211E25;font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:19px;text-transform:uppercase;padding:20px 30px;text-decoration:none;white-space:nowrap">Book a Free Estimate</a>
          <a href={site.phoneTel} style="background:#211E25;color:#FFFFFF;font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:19px;text-transform:uppercase;padding:20px 30px;text-decoration:none;white-space:nowrap">Call {site.phone}</a>
        </div>
      </div>
    </div>
    <div style="position:relative;flex:1 1 440px;min-width:0;min-height:clamp(420px,46vw,760px);overflow:hidden">
      <img class="hero-img" src={img('kitchen8')} alt="Modern kitchen renovation" fetchpriority="high" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
      <div style="position:absolute;left:0;bottom:0;background:#211E25;padding:22px 28px;display:flex;flex-direction:column;gap:2px;max-width:340px">
        <span style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:75%;font-size:64px;line-height:0.9;color:#C8ABEB">30+</span>
        <span style="font-weight:700">years building and repairing homes and businesses in Surrey</span>
      </div>
    </div>
  </section>

  <section style="background:#211E25;border-bottom:1px solid #3A3540">
    <div style="max-width:1440px;margin:0 auto;padding:22px clamp(20px,4vw,56px);display:flex;flex-wrap:wrap;gap:10px 36px;align-items:center;font-family:'Archivo',sans-serif;font-weight:800;font-stretch:80%;font-size:clamp(20px,1.8vw,26px);text-transform:uppercase;letter-spacing:0.02em">
      <span>Renovations</span><span style="color:#7A35B0" aria-hidden="true">/</span><span>Additions</span><span style="color:#7A35B0" aria-hidden="true">/</span><span>Roofing</span><span style="color:#7A35B0" aria-hidden="true">/</span><span>Siding</span><span style="color:#7A35B0" aria-hidden="true">/</span><span>Plumbing</span><span style="color:#7A35B0" aria-hidden="true">/</span><span>Electrical</span><span style="color:#7A35B0" aria-hidden="true">/</span><span>Repairs</span>
    </div>
  </section>

  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px)">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px 60px;margin-bottom:clamp(32px,4vw,48px)">
      <h2 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(52px,6.4vw,112px);line-height:0.86;text-transform:uppercase;margin:0">One contractor.<br><span style="color:#B88CE6">Every trade.</span></h2>
      <p style="margin:0;max-width:26em;color:#DCD7E0">Most companies send you to a different crew for each job. We bring them together, schedule them and stand behind all of it.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:16px">
      {services.map((s) => (
        <a href={`/services#${s.id}`} style="position:relative;display:block;min-height:440px;overflow:hidden;color:#FFFFFF;text-decoration:none;background:#2E2A33">
          <img src={img(s.image)} alt={s.title} loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(33,30,37,0) 30%,rgba(33,30,37,0.94) 100%)"></div>
          <div style="position:absolute;left:0;right:0;bottom:0;padding:28px 30px;display:flex;flex-direction:column;gap:10px">
            <h3 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:75%;font-size:clamp(36px,3.4vw,52px);line-height:0.9;text-transform:uppercase;margin:0">{s.title}</h3>
            <p style="margin:0;color:#ECE8F0;max-width:32em">{s.desc}</p>
            <span style="font-weight:700;font-size:15px;color:#D6BFF2">{s.list}</span>
          </div>
          <span style="position:absolute;top:0;left:0;width:56px;height:8px;background:#7A35B0"></span>
        </a>
      ))}
    </div>
  </section>

  <section style="background:#FFFFFF;color:#211E25">
    <div style="max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr))">
      <div style="position:relative;min-height:clamp(380px,44vw,680px)"><img src={img('framing')} alt="Framing an addition" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></div>
      <div style="padding:clamp(48px,6vw,96px) clamp(20px,4vw,72px);display:flex;flex-direction:column;justify-content:center;gap:32px">
        <h2 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(48px,5.4vw,92px);line-height:0.86;text-transform:uppercase;margin:0">How a job <span style="color:#7A35B0">runs</span></h2>
        <div style="display:flex;flex-direction:column;gap:0">
          <div style="padding:20px 0;border-top:3px solid #211E25"><h3 style="font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:26px;text-transform:uppercase;margin:0 0 4px">A precise estimate</h3><p style="margin:0">We sit down with you and build the quote in specialized software, so the number is accurate and you get it fast.</p></div>
          <div style="padding:20px 0;border-top:3px solid #211E25"><h3 style="font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:26px;text-transform:uppercase;margin:0 0 4px">No surprise changes</h3><p style="margin:0">If anything behind a wall changes the plan, you approve it before extra work starts.</p></div>
          <div style="padding:20px 0;border-top:3px solid #211E25;border-bottom:3px solid #211E25"><h3 style="font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:26px;text-transform:uppercase;margin:0 0 4px">One schedule</h3><p style="margin:0">Our carpenters and concrete crews plus trusted plumbers, electricians and engineers, all on one plan with regular updates to you.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px)">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:36px">
      <h2 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(52px,6.4vw,112px);line-height:0.86;text-transform:uppercase;margin:0">Recent work</h2>
      <a href="/projects" style="font-family:'Archivo',sans-serif;font-weight:800;font-stretch:85%;font-size:18px;text-transform:uppercase;color:#D6BFF2">All projects</a>
    </div>
    <div class="work-grid" style="display:grid;grid-auto-rows:clamp(150px,17vw,260px);gap:10px">
      <div style="grid-column:span 2;grid-row:span 2;overflow:hidden"><img src={img('countertops')} alt="Granite countertops" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="overflow:hidden"><img src={img('remodel1')} alt="Project" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="overflow:hidden"><img src={img('renovation9')} alt="Project" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="grid-column:span 2;overflow:hidden"><img src={img('siding')} alt="Siding" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="overflow:hidden"><img src={img('remodel4')} alt="Project" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="overflow:hidden"><img src={img('finishing6')} alt="Project" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="grid-column:span 2;overflow:hidden"><img src={img('residential')} alt="Residential construction" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover"></div>
    </div>
  </section>

  <section style="background:#7A35B0">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:28px 80px;align-items:center">
      <div>
        <h2 style="font-family:'Archivo',sans-serif;font-weight:900;font-stretch:72%;font-size:clamp(48px,5.6vw,96px);line-height:0.86;text-transform:uppercase;margin:0">Leaking, broken <span style="color:#211E25">or unsafe?</span></h2>
        <p style="margin:18px 0 0;font-size:19px;max-width:28em;font-weight:500">Roof leaks, failed gutters, damaged doors and windows, plumbing problems. Call and tell us what’s happening. We’ll be straight about how soon we can be there.</p>
      </div>
      <a href={site.phoneTel} class="hover-black" style="display:block;background:#211E25;color:#FFFFFF;text-decoration:none;padding:clamp(24px,3vw,40px)">
        <span style="display:block;font-weight:800;font-size:15px;letter-spacing:0.18em;color:#C8ABEB">CALL NOW</span>
        <span style="display:block;font-family:'Archivo',sans-serif;font-weight:900;font-stretch:75%;font-size:clamp(52px,5.8vw,96px);line-height:1">{site.phone}</span>
      </a>
    </div>
  </section>
</Base>
